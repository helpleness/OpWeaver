{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_port": {
          "default": "out",
          "title": "Source Port",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "target_port": {
          "default": "in",
          "title": "Target Port",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "GraphMetadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "Untitled model",
          "title": "Name",
          "type": "string"
        },
        "model_version": {
          "default": "0.1.0",
          "title": "Model Version",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "GraphMetadata",
      "type": "object"
    },
    "ModuleSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "graph_ref": {
          "title": "Graph Ref",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "graph_ref",
        "inputs",
        "outputs"
      ],
      "title": "ModuleSpec",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "operator": {
          "$ref": "#/$defs/OperatorSpec"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Outputs",
          "type": "array"
        },
        "share_with": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Share With"
        },
        "module_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module Ref"
        }
      },
      "required": [
        "id",
        "operator"
      ],
      "title": "Node",
      "type": "object"
    },
    "OperatorSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "default": "1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "OperatorSpec",
      "type": "object"
    },
    "PluginReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "kind": {
          "default": "operator",
          "enum": [
            "operator",
            "model",
            "training",
            "optimization",
            "kernel",
            "backend"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "PluginReference",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "tensor": {
          "anyOf": [
            {
              "$ref": "#/$defs/TensorSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "Port",
      "type": "object"
    },
    "TensorSpec": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "items": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              }
            ]
          },
          "title": "Shape",
          "type": "array"
        },
        "dtype": {
          "default": "float32",
          "enum": [
            "float32",
            "float64",
            "float16",
            "bfloat16",
            "int64",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "device": {
          "default": "any",
          "enum": [
            "cpu",
            "cuda",
            "any"
          ],
          "title": "Device",
          "type": "string"
        }
      },
      "required": [
        "shape"
      ],
      "title": "TensorSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ir_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Ir Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/GraphMetadata"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "title": "Edges",
      "type": "array"
    },
    "modules": {
      "items": {
        "$ref": "#/$defs/ModuleSpec"
      },
      "title": "Modules",
      "type": "array"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/PluginReference"
      },
      "title": "Plugins",
      "type": "array"
    }
  },
  "required": [
    "id"
  ],
  "title": "Graph",
  "type": "object"
}
